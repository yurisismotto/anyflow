<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN connection to the paired computer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Required to hold a WifiManager.MulticastLock while browsing for the
      desktop over mDNS. Without the lock, Wi-Fi hardware filters multicast
      while the screen is off and discovery silently stops working.

      This permission is also one of the permissions that qualifies a service
      for the `connectedDevice` foreground service type on Android 14+, which
      is the type this app uses. That is not a coincidence or a loophole: we
      hold it because we genuinely use multicast.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The ongoing-connection notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scanning the pairing QR code. Requested at the moment of use. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Deliberately absent, and it must stay that way:
        * no BIND_ACCESSIBILITY_SERVICE
        * no BIND_NOTIFICATION_LISTENER_SERVICE
        * no QUERY_ALL_PACKAGES
        * no location permission (this app never needs the user's location)
        * no MANAGE_EXTERNAL_STORAGE
      See docs/security/THREAT_MODEL.md.
    -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".AnyFlowApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Sharesheet entry point: Gallery / Files / Browser -> Share ->
          AnyFlow. Exported because that is what makes it appear in the
          chooser; it accepts only a shared stream and does nothing with an
          empty or unrecognised intent.

          `mimeType="*/*"` is what lets any file type be shared. It grants the
          app nothing: the URI arrives with a temporary read permission for
          that one item, which is strictly less access than any storage
          permission would be, and is exactly why no storage permission is
          declared anywhere in this manifest.
        -->
        <activity
            android:name=".ui.SendActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!--
              Selected text, shared straight to a paired computer as a
              clipboard update. `text/plain` is listed explicitly even though
              `*/*` already matches it, because Android ranks a share target
              higher when the type is named — and because being explicit is
              what documents that shared text takes the clipboard.v1 path,
              not the files.v1 one.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          `connectedDevice`: this service exists only while an active
          connection to a paired computer exists or is being established. It
          is NOT a `dataSync` daemon and it is not started at boot.
        -->
        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          "Send clipboard" in the Quick Settings panel.

          The tile cannot read the clipboard itself: a TileService has no
          input focus, and since Android 10 that is what `getPrimaryClip`
          requires. It therefore opens MainActivity with an explicit request,
          and the Activity — which does have focus — reads the clipboard after
          the person confirms. That is the supported flow, not a workaround
          for one. See ClipboardTileService.

          BIND_QUICK_SETTINGS_TILE is held by the *system*, not by us: it is
          what stops any other app from binding this service.
        -->
        <service
            android:name=".ui.ClipboardTileService"
            android:exported="true"
            android:label="@string/clipboard_tile_label"
            android:icon="@android:drawable/ic_menu_upload"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
