<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. The 108x108 canvas has a 72x72 safe zone; the
  ribbon is scaled and centred to sit inside it, so no launcher mask can clip
  a terminal node off.
-->
