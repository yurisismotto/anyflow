<?xml version="1.0" encoding="utf-8"?>
<!--
  The Flow A: AnyFlow's identity mark, for in-app use at hero sizes.

  The same geometry the launcher icon and the desktop icon carry — one
  continuous ribbon: up the right leg to the apex, down the left leg, and out
  again as the crossbar. Generated from `docs/design/assets/logo-flow-a.svg`;
  `BrandingResourcesTest` asserts the path data still matches it.

  This replaced `logo_flowing_a.xml`, which drew the *older* institutional
  mark. Both existing at once is how an app ends up wearing two identities:
  the desktop moved to the Flow A in the branding sprint that added
  `logo-flow-a.svg` and rewrote `app-icon.svg`, and this is Android catching
  up rather than a second opinion about what AnyFlow looks like.

  The product mark — the Flowing Ribbon, for transfer motifs and empty states
  — is unchanged and still lives in `logo_flowing_ribbon.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp" android:height="64dp"
    android:viewportWidth="64" android:viewportHeight="64">
    <path
        android:pathData="M 53 56 C 50 41 43 22 32 8 C 22 21 15 36 10 47 C 7.5 52.5 11.5 56.5 15.5 52 C 22 43.5 33 38 45 37.5 C 50 37.3 54 38 57 39"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="10" android:startY="56"
                android:endX="54" android:endY="8">
                <item android:offset="0" android:color="#FF16B8A6" />
                <item android:offset="0.5" android:color="#FF4F7CFF" />
                <item android:offset="1" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
