    <!--
      clipboard.v1. Note what is absent from every string here: any way to
      interpolate the clipboard text itself. A notification is visible on the
      lock screen and readable by any notification listener, so a clip must
      never reach one.
    -->
    <string name="channel_clipboard">Clipboard</string>
    <string name="channel_clipboard_description">Clipboard text received from a paired computer.</string>
    <string name="clip_received_title">Clipboard received from %1$s</string>
    <string name="clip_received_body">%1$d bytes of text. Open AnyFlow to copy it.</string>
    <string name="clip_marked_sensitive">Marked sensitive.</string>
    <string name="clip_action_copy">Copy</string>
    <string name="clipboard_tile_label">Send clipboard</string>

    <!--
      How this app's notification listener is named in Android's own
      notification-access screen. It is what a person reads when deciding
      whether to grant the permission, so it says what the listener is for
      rather than repeating the app name.
    -->
    <string name="notification_listener_label">Mirror notifications to a paired computer</string>

    <!--
      notifications.v1 — the consent surface.

      Every string on the notification screens is here rather than inlined in
      Compose, because permission copy is a security control and has to be
      reviewable and translatable as one. Two rules bind what may be written
      here, both from the functional specification (01 §8.1):

        * nothing may offer Android's own OTP redaction as reassurance.
          POC-NOTIF-01 measured this exact device delivering six OTP-shaped
          notifications to an untrusted listener entirely unredacted, with the
          platform flag on and Google's classifier bound. "Android hides
          verification codes" would be false here;
        * nothing may imply AnyFlow inspects notification content. It does not,
          by design (ADR-0015 §5). The honest sentence is the one the product
          can keep: what you choose to share is shared in full with the
          computer you named.

      Note also what cannot be interpolated into any string below: a
      notification's title, body, or an application's own text. There is no
      format specifier here that could take one.
    -->
    <string name="notif_screen_title">Notifications</string>
    <string name="notif_capability_title">Notifications</string>
    <string name="notif_capability_description">Show this device\'s notifications on the computer</string>

    <!-- Gate 1 — Android notification access. -->
    <string name="notif_access_title">Notification access</string>
    <string name="notif_access_allowed">Allowed</string>
    <string name="notif_access_not_allowed">Not allowed</string>
    <string name="notif_access_explainer">Allowing Android notification access lets AnyFlow read notifications on this device. It does not share them with any computer on its own — each computer has to be allowed separately, and then you choose which apps.</string>
    <string name="notif_access_open_settings">Open Android settings</string>
    <string name="notif_access_revoke_hint">Turn this off in Android settings at any time. Doing so stops every computer at once.</string>

    <!-- Gate 2 — the per-peer grant. -->
    <string name="notif_share_title">Share notifications with this computer</string>
    <string name="notif_share_description">Off until you turn it on. Turning it on shares nothing by itself — you choose which apps next.</string>
    <string name="notif_mirror_title">Mirroring</string>
    <string name="notif_mirror_description">Pause without changing anything else</string>

    <!-- Gate 3 and the resulting state. -->
    <string name="notif_status_sharing_off">Off</string>
    <string name="notif_status_needs_access">Needs Android access</string>
    <string name="notif_status_unavailable">Unavailable</string>
    <string name="notif_status_paused">Paused</string>
    <string name="notif_status_no_apps">No apps chosen</string>
    <string name="notif_status_not_connected">Not connected</string>
    <string name="notif_status_peer_not_receiving">Computer is not receiving</string>
    <string name="notif_status_ready">Ready</string>

    <string name="notif_detail_sharing_off">This computer cannot see any notification from this device.</string>
    <string name="notif_detail_needs_access">Android has not given AnyFlow permission to read notifications on this device.</string>
    <string name="notif_detail_unavailable">AnyFlow cannot read notifications right now. This usually clears on its own.</string>
    <string name="notif_detail_paused">Sharing is allowed but paused, so nothing is being sent.</string>
    <string name="notif_detail_no_apps">Nothing is being shared, because no app has been chosen yet.</string>
