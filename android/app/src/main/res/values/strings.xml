    <!--
      The Files screen.

      Every word a person reads about a transfer is here rather than inlined
      in Compose, for the same reason the notification consent copy is: these
      are claims about what happened to someone's file, and a claim has to be
      reviewable in one place and translatable without touching Kotlin.

      Two rules bind what may be written below.

      *A status word must name a state the transfer state machine can prove.*
      There is no string here for "delivered", "synced" or "complete" as
      distinct from what `TransferState` actually reaches, and no string that
      softens a failure into a pause. `files_status_sent` is written only when
      the receiving computer confirmed it has the bytes; `files_status_received`
      only when the hash matched and the file was published.

      *Nothing here can interpolate a URI or a path.* The only format
      specifiers below take a device name or a file's display name. A
      `content://` URI identifies a provider, sometimes an account and
      sometimes a document id, and there is deliberately no string it could be
      substituted into.
    -->
    <!-- The three bottom-bar destinations. -->
    <string name="tab_devices">Devices</string>
    <string name="tab_settings">Settings</string>

    <string name="files_title">Files</string>
    <string name="files_tab">Files</string>
    <string name="files_section_active">Active</string>
    <string name="files_section_recent">Recent</string>

    <!--
      Said plainly, because it is the one thing about this screen a person
      could otherwise get wrong. OmniBridge keeps no transfer history: the list
      is what this app has done since it started, and closing it is not losing
      a log, because there was never a log.
    -->
    <string name="files_recent_scope">Transfers from this session. OmniBridge keeps no history of what you send or receive — received files stay in Downloads/OmniBridge.</string>
    <string name="files_empty_title">No transfers yet</string>
    <string name="files_empty_subtitle">Files you send or receive appear here while they are moving, and stay listed until OmniBridge closes.</string>

