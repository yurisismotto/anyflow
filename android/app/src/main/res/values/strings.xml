    <string name="notif_detail_peer_not_receiving">This device is connected, but the computer has not said it can show notifications. Check that AnyFlow on the computer allows notifications from this device.</string>
    <string name="notif_detail_ready">Notifications from the apps you chose appear on this computer.</string>

