      A plurals resource rather than two strings picked by an `if`: the
      one/other split is English's, and a translator must be able to supply
      their own language's categories without the Kotlin changing.
    -->
    <plurals name="notif_apps_new">
        <item quantity="one">%1$d new app is not being shared</item>
        <item quantity="other">%1$d new apps are not being shared</item>
    </plurals>
    <string name="notif_picker_title">Choose apps</string>
    <string name="notif_picker_intro">Only the apps you tick are shared, and their notifications are shared in full. Nothing is chosen for you.</string>
