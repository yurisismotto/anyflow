    <string name="notif_locked_full_detail">Titles and text are sent as usual.</string>
    <string name="notif_locked_app_only">Share the app name only</string>
    <string name="notif_locked_app_only_detail">The computer is told which app notified, and nothing else. Titles and text are removed on this device, before anything is sent.</string>
    <string name="notif_locked_suppress">Share nothing</string>
    <string name="notif_locked_suppress_detail">Nothing at all is sent while this device is locked.</string>
    <string name="notif_locked_not_retroactive">Unlocking does not send what was held back. The next update from an app arrives in full.</string>

    <string name="notif_work_title">Work profile notifications</string>
    <string name="notif_work_description">Off. Work notifications are never shared unless you turn this on, and the app still has to be chosen.</string>
    <string name="notif_work_absent">This device has no work profile.</string>

    <string name="notif_ongoing_title">Ongoing notifications</string>
    <string name="notif_ongoing_description">Music, navigation and “app is running” notices. Off, because they update constantly and usually cannot be dismissed. The app still has to be chosen.</string>

    <string name="notif_dismiss_title">Sync dismissals</string>
    <string name="notif_dismiss_not_yet">Not available yet. Dismissing a notification on the computer will not dismiss it here.</string>

    <!-- Privacy copy. Reviewed as a security control, not as marketing. -->
    <string name="notif_privacy_title">What is shared, and what is not</string>
    <string name="notif_privacy_body">Notifications from the apps you choose are sent in full to the computer you named, over the same direct, pinned connection as everything else — never to a cloud service. AnyFlow does not read, classify or hide anything inside a notification, and it keeps no history: nothing is written to this device or the computer. AnyFlow never shares its own notifications, and never shares a notification an app marks as private to the lock screen.</string>

