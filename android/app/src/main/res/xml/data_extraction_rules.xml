<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred to a new device. The identity private
  key lives in the Android Keystore and is non-exportable by construction, so
  a restored backup could never contain a usable identity; copying the trust
  store without it would only produce a confusing half-state. Re-pairing is
  the correct recovery path, and it is a deliberate one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
