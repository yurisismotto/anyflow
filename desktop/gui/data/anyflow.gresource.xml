<?xml version="1.0" encoding="UTF-8"?>
<!--
  The brand artwork, compiled into the binary so it cannot go missing when the
  app runs from anywhere other than the source tree.

  Glyph icons are NOT here: the desktop draws them from the platform's own
  Adwaita symbolic set. GTK recolours a symbolic icon by forcing a fill, which
  turns a stroke-drawn glyph into a solid blob — and accent tinting (status
  colours, tinted tiles) is load-bearing in this design, so tintable icons win
  over a bespoke set. The canonical AnyFlow glyph family still lives in
  docs/design/assets/icons and is what Android ships.
-->
<gresources>
  <gresource prefix="/io/github/yurisismotto/anyflow">
    <file preprocess="xml-stripblanks">icon-flowing-ribbon.svg</file>
    <file preprocess="xml-stripblanks">logo-flowing-a.svg</file>
    <file preprocess="xml-stripblanks">ribbon-connection.svg</file>
    <file preprocess="xml-stripblanks">app-icon.svg</file>
  </gresource>
</gresources>
